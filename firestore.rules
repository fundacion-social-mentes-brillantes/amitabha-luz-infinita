rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    match /businesses/{userId}/app/{docId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }
    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }
  }
}
